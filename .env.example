# Use the pooled Neon connection string for the application runtime.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate a unique value with: openssl rand -base64 32
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Local URL in development; use the production domain in Netlify.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# "development" allows any mobile number for OTP testing; "production" (or unset) allows UK mobiles only.
# Set it before building: it is baked into the browser bundle.
NEXT_PUBLIC_APP_ENV=development

# Server-only key used to retrieve property addresses after postcode validation.
IDEAL_POSTCODES_API_KEY=

# Twilio Verify credentials for the quote OTP. Leave empty locally to accept any six-digit code.
# Trial accounts can send only to verified recipients.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Cloudflare R2 credentials used by Payload Media uploads.
R2_BUCKET_NAME=ss-consultants-media
R2_BUCKET_ACCESS_KEY_ID=
R2_BUCKET_SECRET_ACCESS_KEY=
R2_BUCKET_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Public bucket URL (custom domain or r2.dev). When set, images load straight from Cloudflare's CDN.
R2_PUBLIC_URL=https://media.your-domain.co.uk

# Resend (https://resend.com) emails the admin about new quote requests and contact enquiries.
# Leave RESEND_API_KEY empty to only log emails to the console.
RESEND_API_KEY=
# Must be on a domain verified in Resend. Until then, onboarding@resend.dev works but can only
# deliver to the email address of your own Resend account.
EMAIL_FROM_ADDRESS=contact.sscukltd.com
EMAIL_FROM_NAME=SS Consultants Website
# Admin inbox(es) that receive every quote request and contact enquiry notification.
# Separate several addresses with commas. Falls back to the email in Site settings when empty.
ADMIN_NOTIFICATION_EMAIL=
